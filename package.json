{
  "name": "neurovision",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npx react-native run-android --list-devices",
    "ios": "npx react-native run-ios --list-devices",
    "lint": "eslint .",
    "start": "npx react-native start --reset-cache --client-logs",
    "pods": "cd ios && pod deintegrate && rm -f Podfile.lock && RCT_NEW_ARCH_ENABLED=1 bundle install && bundle exec pod install && cd ..",
    "cleanAndroid": "cd android && ./gradlew clean && deleteGradleFiles",
    "deleteGradleFiles": "cd android && rm -rf .gradle && rm -rd .idea && cd ..",
    "cleanPods": "cd ios && pod deintegrate && rm Podfile.lock && cd ..",
    "deletePodlock": "cd ios && rm Podfile.lock && cd ..",
    "cleanProject": "npx react-native clean && npm run deletePodlock && npm run deleteGradleFiles",
    "build:android": "cd android && ./gradlew assembleRelease && cd ..",
    "clean:node_modules": "watchman watch-del-all && rm -rf node_modules && npm cache clean --force && npm install"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "~5.2.8",
    "@hookform/resolvers": "~5.2.2",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-native-community/geolocation": "~3.4.0",
    "@react-native-community/netinfo": "~11.4.1",
    "@react-native-masked-view/masked-view": "~0.3.2",
    "@react-native-vector-icons/material-design-icons": "~12.4.0",
    "@react-navigation/bottom-tabs": "~7.9.0",
    "@react-navigation/native": "~7.1.26",
    "@react-navigation/native-stack": "~7.9.0",
    "@reduxjs/toolkit": "~2.11.2",
    "@tanstack/react-query": "~5.90.12",
    "axios": "~1.13.2",
    "crypto-js": "~4.2.0",
    "dayjs": "~1.11.19",
    "react": "19.2.0",
    "react-hook-form": "~7.69.0",
    "react-native": "0.83.1",
    "react-native-date-picker": "5.0.12",
    "react-native-device-info": "~15.0.1",
    "react-native-flash-message": "~0.4.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-html-to-pdf": "~1.3.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-controller": "~1.20.2",
    "react-native-keychain": "~10.0.0",
    "react-native-linear-gradient": "~2.8.3",
    "react-native-pager-view": "~8.0.0",
    "react-native-paper": "~5.14.5",
    "react-native-permissions": "^5.4.4",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.19.0",
    "react-native-svg": "~15.15.1",
    "react-native-worklets": "~0.7.1",
    "react-redux": "~9.2.0",
    "zod": "~4.2.1"
  },
  "devDependencies": {
    "@babel/core": "~7.28.5",
    "@babel/preset-env": "~7.28.5",
    "@babel/runtime": "~7.28.4",
    "@react-native-community/cli": "~20.0.2",
    "@react-native-community/cli-platform-android": "~20.0.2",
    "@react-native-community/cli-platform-ios": "~20.0.2",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/crypto-js": "~4.2.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.7",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "~29.7.0",
    "babel-plugin-module-resolver": "~5.0.2",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "3.7.4",
    "react-native-svg-transformer": "~1.5.2",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
