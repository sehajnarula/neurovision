{
  "name": "neurovision",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npx react-native run-android --list-devices",
    "ios": "npx react-native run-ios --list-devices",
    "lint": "eslint .",
    "start": "npx react-native start --reset-cache --client-logs",
    "pods": "cd ios && pod deintegrate && rm -f Podfile.lock && RCT_NEW_ARCH_ENABLED=1 bundle install && bundle exec pod install && cd ..",
    "cleanAndroid": "cd android && ./gradlew clean && deleteGradleFiles",
    "deleteGradleFiles": "cd android && rm -rf .gradle && rm -rd .idea && cd ..",
    "cleanPods": "cd ios && pod deintegrate && rm Podfile.lock && cd ..",
    "deletePodlock": "cd ios && rm Podfile.lock && cd ..",
    "cleanProject": "npx react-native clean && npm run deletePodlock && npm run deleteGradleFiles",
    "build:android": "cd android && ./gradlew assembleRelease && cd ..",
    "clean:node_modules": "watchman watch-del-all && rm -rf node_modules && npm cache clean --force && npm install"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "~5.2.14",
    "@hookform/resolvers": "~5.9.0",
    "@react-native-community/geolocation": "~3.4.0",
    "@react-native-community/netinfo": "~12.0.1",
    "@react-native-firebase/app": "^26.2.0",
    "@react-native-firebase/auth": "^26.2.0",
    "@react-native-firebase/firestore": "^26.2.0",
    "@react-native-masked-view/masked-view": "~0.3.2",
    "@react-native-vector-icons/material-design-icons": "~12.4.0",
    "@react-navigation/bottom-tabs": "~7.18.16",
    "@react-navigation/native": "~7.3.16",
    "@react-navigation/native-stack": "~7.18.8",
    "@reduxjs/toolkit": "~2.12.0",
    "@tanstack/react-query": "~5.101.4",
    "axios": "~1.19.0",
    "dayjs": "~1.11.21",
    "react": "19.2.3",
    "react-hook-form": "~7.85.0",
    "react-native": "0.86.2",
    "react-native-device-info": "~15.0.2",
    "react-native-flash-message": "~0.4.2",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-controller": "~1.22.3",
    "react-native-linear-gradient": "~2.8.3",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-pager-view": "~9.0.2",
    "react-native-paper": "~5.15.3",
    "react-native-permissions": "^5.6.1",
    "react-native-reanimated": "~4.5.3",
    "react-native-safe-area-context": "~5.9.0",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "~15.15.5",
    "react-native-worklets": "~0.11.4",
    "react-redux": "~9.3.0",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@babel/core": "~7.25.2",
    "@babel/preset-env": "~7.25.3",
    "@babel/runtime": "~7.25.0",
    "@react-native-community/cli": "~20.2.0",
    "@react-native-community/cli-platform-android": "~20.2.0",
    "@react-native-community/cli-platform-ios": "~20.2.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.7",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "~29.7.0",
    "babel-plugin-module-resolver": "~5.0.2",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "3.7.4",
    "react-native-svg-transformer": "~1.5.2",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
